# Bluetooth — BTstack host on the ESP32 controller
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_BTSTACK_ENABLED=y
CONFIG_BTSTACK_INTERNAL_BT=y
CONFIG_BTSTACK_AUDIO=n
CONFIG_BTSTACK_MESH_ENABLED=n

# Classic BT only (RFCOMM needs BR/EDR)
CONFIG_BT_CONTROLLER_MODE_BR_EDR_ONLY=y

# WiFi
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# lwIP NAT
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_IPV4_NAPT_PORTMAP=y

# lwIP PPP server — terminates the phone's PPP-over-RFCOMM link.
# PAP/CHAP/MSCHAP/MPPE deliberately stay off: no auth option must ever hit
# the wire (old Symbian PPP crashes on auth options), and no CCP/MPPE.
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_SERVER_SUPPORT=y
CONFIG_LWIP_PPP_VJ_HEADER_COMPRESSION=n
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y

# Optimize for size (-Os): required to fit BT + WiFi + PPP into IRAM/flash
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Partition table: single app large (1.5MB)
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_PARTITION_TABLE_FILENAME="partitions_singleapp_large.csv"
